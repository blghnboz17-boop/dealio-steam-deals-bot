DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id

# Optional: used only to remove legacy guild-specific commands during migration.
DISCORD_GUILD_ID=

# Optional: required only for Steam vanity-name and /id/ profile resolution.
STEAM_WEB_API_KEY=

# Optional in local development; configure for the branded controlled-beta experience.
# Host docs/assets/dealio-onboarding-banner.png on a stable public HTTPS URL.
DEALIO_BANNER_URL=

DATABASE_PATH=./data/wishlist.db
# Wait 30 minutes after a completed scan; 0.5 hours = 30 minutes.
POLL_INTERVAL_HOURS=0.5
NOTIFICATION_RETRY_INTERVAL_SECONDS=60

# Azure production must set true. Provision the private <app-id>.lock blob first.
DEALIO_PRODUCTION=false
AZURE_LEASE_CONTAINER_URL=
# Mandatory on developer machines: protects against accidental production login.
PRODUCTION_DISCORD_CLIENT_ID=
AZURE_BACKUP_CONTAINER_URL=
AZURE_MONITOR_ENDPOINT=
AZURE_MONITOR_RULE_ID=
AZURE_MONITOR_STREAM=Custom-DealioHealth

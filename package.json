{
  "name": "dealio",
  "version": "0.1.0",
  "private": true,
  "description": "Dealio notifies Discord users when Steam wishlist games go on sale.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:scenarios": "tsc -p tsconfig.scenarios.json",
    "test:capacity": "tsx scripts/capacity-check.ts",
    "typecheck:handoff": "npm run typecheck --prefix .opencode",
    "pretest": "npm run build",
    "test": "vitest run --passWithNoTests --maxWorkers=4",
    "test:handoff": "vitest run --passWithNoTests",
    "preview:ui": "npm run build && node scripts/preview-ui.mjs",
    "backup": "node scripts/backup.mjs",
    "restore:test": "node scripts/backup.mjs --restore-test",
    "monitor:preview": "node scripts/monitor.mjs --preview",
    "metrics:report": "node scripts/metrics-report.mjs",
    "release:check": "node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.2",
    "@azure/monitor-ingestion": "^1.2.0",
    "@azure/storage-blob": "^12.33.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}

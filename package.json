{
  "name": "dealio",
  "version": "0.1.0",
  "private": true,
  "description": "Dealio notifies Discord users when Steam wishlist games go on sale.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:handoff": "npm run typecheck --prefix .opencode",
    "test": "vitest run --passWithNoTests",
    "test:handoff": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}

[Unit]
Description=Dealio Steam wishlist Discord bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bilgehan
Group=bilgehan
WorkingDirectory=/home/bilgehan/code/steam-wishlist-discord-bot
ExecStart=/home/bilgehan/.local/bin/node --optimize-for-size /home/bilgehan/code/steam-wishlist-discord-bot/dist/index.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

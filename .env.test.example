# Create a separate Discord Developer Portal application; never copy the production token.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set this to the real production application ID so a mistaken test start is rejected.
PRODUCTION_DISCORD_CLIENT_ID=1540325119690412172
DATABASE_PATH=./data/test-wishlist.db
DEALIO_PRODUCTION=false
POLL_INTERVAL_HOURS=0.5
NOTIFICATION_RETRY_INTERVAL_SECONDS=60
# Optional admin panel for local testing (http://localhost:8787).
DEALIO_ADMIN_TOKEN=
DEALIO_ADMIN_PORT=8787
